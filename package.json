{
  "name": "math-qna",
  "version": "0.1.0",
  "private": true,
  "//engines": "firebase-admin v14가 요구하는 Node 버전.",
  "engines": {
    "node": "24.x"
  },
  "//overrides": "firebase-admin/auth → jwks-rsa(CommonJS) → jose. jose 6은 ESM 전용(exports에 require 조건이 없음)이라 jwks-rsa의 require('jose')가 ERR_REQUIRE_ESM으로 터진다. Next가 firebase-admin을 기본 external로 두고 네이티브 require로 불러오기 때문에 배포 환경에서 라우트가 통째로 죽는다. jose 5는 CJS 빌드를 제공하고, jwks-rsa가 쓰는 심볼은 importJWK·exportSPKI 둘뿐이라 5로 내려도 안전하다.",
  "overrides": {
    "jose": "^5.10.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:rules": "firebase emulators:exec --project demo-math-qna \"vitest run\""
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "firebase-tools": "^15.30.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
